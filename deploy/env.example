# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Address people open in the browser, e.g. http://192.168.0.50:3000 for a Raspberry Pi
SITE_URL=

# Database password for the bundled PostgreSQL (any long random string)
POSTGRES_PASSWORD=

# Same values as in your local .env
REQUEST_CONTACT_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=

# Shown on the terms and privacy pages
SITE_OPERATOR=
CONTACT_EMAIL=

# Not needed to run the site; only the auto.ria collector uses it
AUTO_RIA_API_KEY=
