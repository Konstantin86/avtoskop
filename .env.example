# Local database (matches docker-compose.yml)
POSTGRES_USER=avtoskop
POSTGRES_PASSWORD=avtoskop
POSTGRES_DB=avtoskop
POSTGRES_PORT=5433
DATABASE_URL=postgres://avtoskop:avtoskop@localhost:5433/avtoskop

# auto.ria API (https://developers.ria.com)
AUTO_RIA_API_KEY=

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Email (https://resend.com)
RESEND_API_KEY=

# Bot check (https://www.cloudflare.com/products/turnstile/)
TURNSTILE_SECRET_KEY=

# Encrypts buyer phone numbers (32 random bytes, base64): openssl rand -base64 32
REQUEST_CONTACT_KEY=

# Public address of the site, used in links the bot sends
SITE_URL=http://localhost:3000

# Telegram bot for seller sign-in and buyer confirmation (create it in @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Local only: shows a "test seller" sign-in button in development
AVTOSKOP_DEV_LOGIN=0
